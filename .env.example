# Valores locais de exemplo. Copie para .env (ignorado pelo git e pelo Docker) antes de subir o compose.
POSTGRES_DB=nexo
POSTGRES_USER=nexo
POSTGRES_PASSWORD=change-me-local
# URL JDBC usada pela API quando roda fora do Docker (IDE ou ./mvnw spring-boot:run): aponta
# para a porta publicada no host. A API no compose ignora esta variavel (usa o servico postgres:5432).
POSTGRES_URL=jdbc:postgresql://localhost:5432/nexo
# Porta do host para o PostgreSQL (a do container segue 5432). Padrao 5432. Se ela estiver
# ocupada por outro PostgreSQL no computador, descomente e mude, e use a mesma porta no POSTGRES_URL.
# POSTGRES_PORT=5433
# Porta do host para a API; mude se a 8080 estiver ocupada.
APP_PORT=8080
